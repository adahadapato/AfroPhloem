<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Uncomment to also build for Tizen
    <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks>
    -->

    <OutputType>Exe</OutputType>
    <RootNamespace>Phloem</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Phloem</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.zayun.phloem</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Min / Target OS versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- Compile bindings that use Source={x:Reference …} too (faster, checked at build time) -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\Images\appicon.png" ForegroundFile="Resources\Images\appiconfg.png" Color="#2B3A25" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Images\splash.png" Color="#2B3A25" BaseSize="200,200" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" Exclude="Resources\Images\appicon.png;Resources\Images\appiconfg.png;Resources\Images\splash.png" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <!-- API client: settings files, typed settings, HttpClient factory -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- App settings (API address), read at start-up by MauiProgram. NO secrets: they ship inside the app. -->
    <EmbeddedResource Include="Settings\appsettings.json" LogicalName="appsettings.json" />
    <!-- Debug builds only: your local API. The file is git-ignored (it's only on your PC), so it's embedded only when
         it exists: GitHub's build machines don't have it, and the app treats it as optional (MauiProgram). -->
    <EmbeddedResource Include="Settings\appsettings.Development.json" LogicalName="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug' And Exists('Settings\appsettings.Development.json')" />
  </ItemGroup>

