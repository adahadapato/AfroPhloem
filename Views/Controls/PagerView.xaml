<?xml version="1.0" encoding="UTF-8" ?>
<!--
    PagerView: the bottom of a long list.

        ( ◀ )     Page  2  of 7     ( ▶ )
        21–40 of 137                Show  20 ▾

    Bind it to the list's Paging:  <controls:PagerView Paging="{Binding Pager}" />
    Optional ScrollTarget="{x:Reference SomeTitle}": changing page scrolls there (default: the top).
    Hidden while the list fits in the smallest "Show" choice; ◀ ▶ hidden when there's one page.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             x:Class="Phloem.Views.Controls.PagerView">

    <Border x:Name="Card" x:DataType="vm:Paging" IsVisible="{Binding IsVisible}"
            BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
            StrokeShape="RoundRectangle 22" Padding="14,12" Margin="0,10,0,4">
        <Border.Shadow>
            <Shadow Brush="{StaticResource BrandDark}" Opacity="0.10" Radius="14" Offset="0,4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="10">

            <!-- ============ ◀  Page 2 of 7  ▶ ============ -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasManyPages}">

                <!-- Previous -->
                <Border x:Name="PreviousButton" WidthRequest="48" HeightRequest="48"
                        StrokeShape="Ellipse" StrokeThickness="0" VerticalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource BrandGreen}" Offset="0.0" />
                            <GradientStop Color="{StaticResource BrandDark}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BrandDark}" Opacity="0.30" Radius="8" Offset="0,3" />
                    </Border.Shadow>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding CanGoBack}" Value="False">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource BrandMintPale}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Stroke" Value="{StaticResource BrandMint}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="Shadow">
                                <Setter.Value>
                                    <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviousTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M14,5 L7,12 L14,19" Stroke="White" StrokeThickness="2.8"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="22" HeightRequest="22"
                          HorizontalOptions="Center" VerticalOptions="Center" Margin="-2,0,0,0">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding CanGoBack}" Value="False">
                                <Setter Property="Stroke" Value="{StaticResource BrandMint}" />
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>
                </Border>

                <!-- Page 2 of 7 -->
                <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                        BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Padding="18,7">
                    <Label HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Page  " FontSize="13" TextColor="{StaticResource BrandTextMuted}" />
                                <Span Text="{Binding PageNumberText}" FontSize="20" FontAttributes="Bold"
                                      TextColor="{StaticResource BrandDark}" />
                                <Span Text="  of " FontSize="13" TextColor="{StaticResource BrandTextMuted}" />
                                <Span Text="{Binding TotalPagesText}" FontSize="15" FontAttributes="Bold"
                                      TextColor="{StaticResource BrandGreen}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Border>

                <!-- Next -->
                <Border x:Name="NextButton" Grid.Column="2" WidthRequest="48" HeightRequest="48"
                        StrokeShape="Ellipse" StrokeThickness="0" VerticalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource BrandGreen}" Offset="0.0" />
                            <GradientStop Color="{StaticResource BrandDark}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BrandDark}" Opacity="0.30" Radius="8" Offset="0,3" />
                    </Border.Shadow>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding CanGoNext}" Value="False">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource BrandMintPale}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Stroke" Value="{StaticResource BrandMint}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                            <Setter Property="Shadow">
                                <Setter.Value>
                                    <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M10,5 L17,12 L10,19" Stroke="White" StrokeThickness="2.8"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="22" HeightRequest="22"
                          HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding CanGoNext}" Value="False">
                                <Setter Property="Stroke" Value="{StaticResource BrandMint}" />
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>
                </Border>
            </Grid>

            <!-- ============ 21–40 of 137          Show 20 ▾ ============ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="{Binding RangeText}" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />

                <Border x:Name="SizeButton" Grid.Column="1" BackgroundColor="{StaticResource BrandCream}"
                        Stroke="{StaticResource BrandGold}" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16" Padding="12,5" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSizeTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Show" FontSize="12" TextColor="{StaticResource BrandTextMuted}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding PageSize}" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDark}" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandOrange}" StrokeThickness="2"
                              StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
