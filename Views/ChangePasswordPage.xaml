<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ChangePasswordPage (NEW): My account → Change password (route "changepassword").
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             xmlns:phloem="clr-namespace:Phloem"
             x:DataType="vm:ChangePasswordViewModel"
             x:Class="Phloem.Views.ChangePasswordPage"
             Shell.NavBarIsVisible="False"
             Title="Change password">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>
        <!-- checklist row: grey dot, turns green with a tick when the rule is met -->
        <Style x:Key="RuleDot" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="Ellipse" />
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="BackgroundColor" Value="{StaticResource BrandBorder}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14" MaximumWidthRequest="560" HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="2" Margin="2,0,0,0">
                    <Label Text="Change password" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Keep your account safe" Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16,18">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">

                        <!-- Current -->
                        <VerticalStackLayout>
                            <Label Text="Current password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding CurrentPassword}" IsPassword="{Binding HidePasswords}"
                                           Placeholder="Your current password" TextColor="{StaticResource BrandTextDark}"
                                           VerticalOptions="Center" />
                                    <!-- eye -->
                                    <Grid Grid.Column="1" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                        <Path Data="M2,12 C5,6.5 8.5,5 12,5 C15.5,5 19,6.5 22,12 C19,17.5 15.5,19 12,19 C8.5,19 5,17.5 2,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"
                                              Stroke="{StaticResource BrandTextMuted}" StrokeThickness="1.6"
                                              WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleShowCommand}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" />

                        <!-- New -->
                        <VerticalStackLayout>
                            <Label Text="New password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding NewPassword}" IsPassword="{Binding HidePasswords}"
                                       Placeholder="At least 8 characters" TextColor="{StaticResource BrandTextDark}"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- live checklist -->
                            <VerticalStackLayout Spacing="6" Margin="4,10,0,0">
                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource RuleDot}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding HasMinLength}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Path Data="M4,8 L7,11 L12,5" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round"
                                              WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="At least 8 characters" FontSize="12" TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource RuleDot}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding HasLetter}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Path Data="M4,8 L7,11 L12,5" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round"
                                              WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Contains a letter" FontSize="12" TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Border Style="{StaticResource RuleDot}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding HasNumber}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Path Data="M4,8 L7,11 L12,5" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round"
                                              WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Contains a number" FontSize="12" TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Confirm -->
                        <VerticalStackLayout>
                            <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding ConfirmPassword}" IsPassword="{Binding HidePasswords}"
                                       Placeholder="Type it again" TextColor="{StaticResource BrandTextDark}"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />

                <Button Text="Update password" Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                        FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="52" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
