<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AdminShopDetailsPage (route "adminshop?id=…"): one shop for an admin, from the API.
    Logo + cover, details, documents (Open through a 10-minute secure link, Accept / Reject each),
    what's missing for the ✓ badge, and Approve / Reject (pending) or ✓ / Block (approved).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             x:DataType="vm:AdminShopDetailsViewModel"
             x:Class="Phloem.Views.AdminShopDetailsPage"
             Shell.NavBarIsVisible="False"
             Title="Shop details">

    <ContentPage.Resources>
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallMuted" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="12" MaximumWidthRequest="600" HorizontalOptions="Fill">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource BrandDark}" HeightRequest="28" />
                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasShop}">

                    <!-- ============ COVER + LOGO ============ -->
                    <Grid HeightRequest="150">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="120"
                                VerticalOptions="Start">
                            <Image Source="{Binding CoverPhotoUrl}" Aspect="AspectFill" />
                        </Border>
                        <Border StrokeThickness="3" Stroke="White" StrokeShape="Ellipse" BackgroundColor="White"
                                WidthRequest="72" HeightRequest="72" HorizontalOptions="Start" VerticalOptions="End"
                                Margin="14,0,0,0">
                            <Image Source="{Binding Shop.LogoUrl}" Aspect="AspectFill" />
                        </Border>
                    </Grid>

                    <!-- ============ DETAILS ============ -->
                    <VerticalStackLayout Spacing="3" Margin="2,0,0,0">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Shop.Name}" FontSize="24" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="✓" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}"
                                   VerticalOptions="Center" IsVisible="{Binding Shop.IsVerified}" />
                        </HorizontalStackLayout>
                        <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8" Padding="8,3" HorizontalOptions="Start">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Shop.IsBad}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#FDECEA" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Shop.StatusText}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                        </Border>
                        <Label Text="{Binding Shop.Shop.RejectionReason, StringFormat='Rejected because: {0}'}"
                               FontSize="13" TextColor="{StaticResource BrandDanger}" LineBreakMode="WordWrap"
                               IsVisible="{Binding Shop.Shop.RejectionReason, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Owner" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Shop.Shop.OwnerName}" FontSize="14" TextColor="{StaticResource BrandTextDark}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Business email and phone" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Shop.EmailText}" FontSize="14" TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="{Binding Shop.Shop.BusinessPhone}" FontSize="14" TextColor="{StaticResource BrandTextDark}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Country, opened, rating" Style="{StaticResource CardTitle}" />
                                <Label FontSize="14" TextColor="{StaticResource BrandTextDark}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Shop.CountryText}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding Shop.OpenedText}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding Shop.RatingText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ DECISIONS ============ -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Shop.IsPending}">
                        <Button Text="Approve" Command="{Binding ApproveCommand}" Style="{StaticResource CtaButton}" />
                        <Button Grid.Column="1" Text="Reject" Command="{Binding RejectCommand}"
                                Style="{StaticResource OutlineButton}" TextColor="{StaticResource BrandDanger}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Shop.CanManage}">
                        <Button Text="{Binding Shop.VerifyButtonText}" Command="{Binding ToggleVerifiedCommand}"
                                Style="{StaticResource CtaButton}" />
                        <Button Grid.Column="1" Text="{Binding Shop.BlockButtonText}" Command="{Binding ToggleBlockCommand}"
                                Style="{StaticResource OutlineButton}" TextColor="{StaticResource BrandDanger}" />
                    </Grid>

                    <!-- ============ DOCUMENTS ============ -->
                    <Label Text="Documents" Style="{StaticResource SectionTitle}" FontSize="17" Margin="2,8,0,0" />
                    <Label Text="{Binding MissingText}" Style="{StaticResource SmallMuted}" LineBreakMode="WordWrap" Margin="2,-6,0,0" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Documents}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminDocumentRow">
                                <Border Style="{StaticResource WhiteCard}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextDark}" />
                                        <Label Text="{Binding FileText}" Style="{StaticResource SmallMuted}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandDark}" LineBreakMode="WordWrap">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsBad}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource BrandDanger}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                            <Button Text="Open" Style="{StaticResource ChipButton}"
                                                    BackgroundColor="White" TextColor="{StaticResource BrandDark}"
                                                    BorderColor="{StaticResource BrandBorder}" BorderWidth="1"
                                                    Command="{Binding OpenDocumentCommand, Source={RelativeSource AncestorType={x:Type vm:AdminShopDetailsViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Accept" Style="{StaticResource ChipButton}"
                                                    BackgroundColor="{StaticResource BrandMint}" TextColor="{StaticResource BrandDark}"
                                                    IsVisible="{Binding IsPending}"
                                                    Command="{Binding AcceptDocumentCommand, Source={RelativeSource AncestorType={x:Type vm:AdminShopDetailsViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Reject" Style="{StaticResource ChipButton}"
                                                    BackgroundColor="{StaticResource BrandPeach}" TextColor="{StaticResource BrandOrange}"
                                                    IsVisible="{Binding IsPending}"
                                                    Command="{Binding RejectDocumentCommand, Source={RelativeSource AncestorType={x:Type vm:AdminShopDetailsViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
