<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ShopSettingsPage: Seller dashboard → Shop settings (route "shopsettings"), on the API.
    Approval status, pictures, details, delivery fee, "orders for today close at", documents.
    Personal details are on My account → Edit profile.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             xmlns:phloem="clr-namespace:Phloem"
             x:DataType="vm:ShopSettingsViewModel"
             x:Class="Phloem.Views.ShopSettingsPage"
             Shell.NavBarIsVisible="False"
             Title="Shop settings">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16,18" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        </Style>
        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource BrandDark}" />
            <Setter Property="BorderColor" Value="{StaticResource BrandMint}" />
            <Setter Property="BorderWidth" Value="1.5" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- Saved / why it didn't work: always in view, whatever card was used -->
        <controls:StatusBanner Grid.Row="1" Message="{Binding StatusMessage}" IsError="{Binding IsError}"
                               Margin="16,10,16,0" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource BrandDark}">
        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,28" Spacing="14" MaximumWidthRequest="560" HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="2" Margin="2,0,0,0">
                    <Label Text="Shop settings" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="{Binding ShopSince}" Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <!-- ============ APPROVAL STATUS ============ -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,12"
                        BackgroundColor="{StaticResource BrandMintPale}" IsVisible="{Binding HasShop}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNotLive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPeach}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="Ellipse"
                                BackgroundColor="{StaticResource BrandGreen}" VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsNotLive}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandOrange}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                        <Label Grid.Column="1" Text="{Binding ApprovalText}" FontSize="13"
                               TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ============ PICTURES: cover photo with the logo on it ============ -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasShop}">
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="150">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18,18,0,0">
                                <Image Source="{Binding CoverPhotoUrl}" Aspect="AspectFill" />
                            </Border>
                            <Border WidthRequest="76" HeightRequest="76" StrokeShape="Ellipse" StrokeThickness="3"
                                    Stroke="White" BackgroundColor="{StaticResource BrandMintPale}"
                                    HorizontalOptions="Start" VerticalOptions="End" Margin="16,0,0,-30">
                                <Image Source="{Binding LogoUrl}" Aspect="AspectFill" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout Padding="16,40,16,16" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="Logo" Style="{StaticResource FieldLabel}" VerticalOptions="Center" Margin="2,0,0,0" />
                                <Button Grid.Column="1" Text="Change" Style="{StaticResource PillButton}"
                                        Command="{Binding ChangeLogoCommand}" />
                                <Button Grid.Column="2" Text="Remove" Style="{StaticResource PillButton}"
                                        TextColor="{StaticResource BrandDanger}" Command="{Binding RemoveLogoCommand}"
                                        IsVisible="{Binding HasLogo}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="Cover photo" Style="{StaticResource FieldLabel}" VerticalOptions="Center" Margin="2,0,0,0" />
                                <Button Grid.Column="1" Text="Change" Style="{StaticResource PillButton}"
                                        Command="{Binding ChangeCoverPhotoCommand}" />
                                <Button Grid.Column="2" Text="Remove" Style="{StaticResource PillButton}"
                                        TextColor="{StaticResource BrandDanger}" Command="{Binding RemoveCoverPhotoCommand}"
                                        IsVisible="{Binding HasCoverPhoto}" />
                            </Grid>
                            <Label Text="Shops with a logo and cover photo get more orders." Style="{StaticResource Hint}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ BUSINESS DETAILS ============ -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasShop}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Shop details" Style="{StaticResource CardTitle}" />

                        <VerticalStackLayout>
                            <Label Text="Shop name" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding BusinessName}" Placeholder="e.g. Mama Ama's Kitchen"
                                       TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Shown on every one of your dishes." Style="{StaticResource Hint}" Margin="2,6,0,0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Business email" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding BusinessEmail}" Placeholder="orders@yourshop.com" Keyboard="Email"
                                       TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Business phone" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Text="{Binding BusinessPhone}" Placeholder="+233 24 555 0192" Keyboard="Telephone"
                                       TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Leave email or phone empty to use your personal ones." Style="{StaticResource Hint}"
                                   Margin="2,6,0,0" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Shop country" Style="{StaticResource FieldLabel}" Margin="2,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ShopCountry}" FontSize="14"
                                   TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                        </Grid>

                        <Button Text="Save shop details" Command="{Binding SaveCommand}" Style="{StaticResource SaveButton}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ DELIVERY FEE ============ -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasShop}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Delivery fee" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding FeeRangeText}" Style="{StaticResource Hint}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource FieldBox}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="{Binding CurrencySymbol}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding DeliveryFeeText}" Keyboard="Numeric"
                                           TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Text="Save fee" Command="{Binding SaveDeliveryFeeCommand}"
                                    Style="{StaticResource SaveButton}" HeightRequest="50" Padding="18,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ORDERS FOR TODAY CLOSE AT ============ -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasShop}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Orders for today close at" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding CutoffHint}" Style="{StaticResource Hint}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource FieldBox}">
                                <TimePicker Time="{Binding OrderCutoff}" Format="h:mm tt"
                                            TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            </Border>
                            <Button Grid.Column="1" Text="Save time" Command="{Binding SaveCutoffCommand}"
                                    Style="{StaticResource SaveButton}" HeightRequest="50" Padding="18,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ DOCUMENTS ============ -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasShop}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Documents" Style="{StaticResource CardTitle}" />
                        <Label Text="Phloem checks these before giving your shop the ✓ badge. PDF, JPEG or PNG, up to 10 MB."
                               Style="{StaticResource Hint}" />

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Documents}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShopDocumentRow">
                                    <Border BackgroundColor="{StaticResource BrandCard}" Stroke="{StaticResource BrandBorder}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding NeedsAttention}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource BrandOrange}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAccepted}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource BrandMint}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                            <Label Grid.Row="1" Text="{Binding RequiredText}" FontSize="11"
                                                   TextColor="{StaticResource BrandTextMuted}" />
                                            <Label Grid.Row="2" Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDark}" Margin="0,4,0,0">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource BrandOrange}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Row="3" Text="{Binding FileText}" FontSize="11" LineBreakMode="MiddleTruncation"
                                                   TextColor="{StaticResource BrandTextMuted}" IsVisible="{Binding HasFile}" />
                                            <Button Grid.Column="1" Grid.RowSpan="4" Text="{Binding ButtonText}"
                                                    Style="{StaticResource PillButton}" VerticalOptions="Center"
                                                    Command="{Binding UploadDocumentCommand, Source={RelativeSource AncestorType={x:Type vm:ShopSettingsViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Link to personal details -->
                <Label HorizontalOptions="Center" FontSize="13" Margin="0,6,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Your name and personal phone are in " TextColor="{StaticResource BrandTextMuted}" />
                            <Span Text="My account" TextColor="{StaticResource BrandDark}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditPersonalCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
