<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AfroPhloem.ViewModels"
             xmlns:models="clr-namespace:AfroPhloem.Models"
             xmlns:controls="clr-namespace:AfroPhloem.Views.Controls"
             x:DataType="vm:CheckoutViewModel"
             x:Class="AfroPhloem.Views.CheckoutPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="Checkout">

    <Grid RowDefinitions="Auto,*">
        <!--<controls:AppHeaderBar Grid.Row="0" ShowSearch="False" />-->
        <controls:AppHeaderBar Grid.Row="0" ShowSearch="False"
                        SelectedCountry="{Binding SelectedCountry}" />

        <Grid Grid.Row="1">

            <!-- ============ ORDER FORM ============ -->
            <ScrollView IsVisible="{Binding OrderPlaced, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Padding="16" Spacing="18" MaximumWidthRequest="560" HorizontalOptions="Center">

                    <Label Text="{Binding ItemCount, StringFormat='Order Summary · {0} item(s)'}" Style="{StaticResource SectionTitle}" />
                   
                    <!-- Order items -->
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CartItem">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                WidthRequest="54" HeightRequest="54" Padding="0">
                                            <Image Source="{Binding Dish.ImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Dish.Name}" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding Dish.Price, StringFormat='£{0:0.00} each'}" Style="{StaticResource SubtleLabel}" />
                                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                <Button Text="−" Style="{StaticResource CircleIconButton}" WidthRequest="28" HeightRequest="28" FontSize="14"
                                                        Command="{Binding BindingContext.DecreaseQuantityCommand, Source={x:Reference RootPage}}"
                                                        CommandParameter="{Binding .}" />
                                                <Label Text="{Binding Quantity}" VerticalOptions="Center" FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandTextDark}" WidthRequest="20" HorizontalTextAlignment="Center" />
                                                <Button Text="+" Style="{StaticResource CircleIconButton}" WidthRequest="28" HeightRequest="28" FontSize="14"
                                                        Command="{Binding BindingContext.IncreaseQuantityCommand, Source={x:Reference RootPage}}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding LineTotal, StringFormat='£{0:0.00}'}"
                                               FontAttributes="Bold" FontSize="15" TextColor="{StaticResource BrandGreen}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- International shipment recap, only if the person came from the "Send to UK" flow -->
                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasInternationalDelivery}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Style="{StaticResource IconCircle}" BackgroundColor="{StaticResource BrandGold}" Margin="0,0,12,0">
                                <Label Text="✈️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="International Shipment" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="{Binding InternationalDelivery.RecipientName, StringFormat='To: {0}'}" Style="{StaticResource SubtleLabel}" />
                                <Label Text="{Binding InternationalDelivery.UkAddress, StringFormat='Address: {0}'}" Style="{StaticResource SubtleLabel}" />
                                <Label Text="{Binding InternationalDelivery.Speed, StringFormat='Speed: {0}'}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Price breakdown -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Subtotal" TextColor="{StaticResource BrandTextMuted}" />
                                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='£{0:0.00}'}" TextColor="{StaticResource BrandTextDark}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Delivery Fee" TextColor="{StaticResource BrandTextMuted}" />
                                <Label Grid.Column="1" Text="{Binding DeliveryFee, StringFormat='£{0:0.00}'}" TextColor="{StaticResource BrandTextDark}" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandBorder}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Total" FontAttributes="Bold" FontSize="19" TextColor="{StaticResource BrandTextDark}" />
                                <Label Grid.Column="1" Text="{Binding Total, StringFormat='£{0:0.00}'}" FontAttributes="Bold" FontSize="19" TextColor="{StaticResource BrandGreen}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Payment method -->
                    <Label Text="Payment Method" Style="{StaticResource SectionTitle}" FontSize="17" />

                    <CollectionView ItemsSource="{Binding PaymentMethods}" SelectionMode="Single"
                                     SelectedItem="{Binding SelectedPaymentMethod}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PaymentMethodOption">
                                <Border x:Name="PayBorder" Style="{StaticResource PaymentCard}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" Margin="0,0,12,0" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label x:Name="NameLabel" Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource SubtleLabel}" />
                                        </VerticalStackLayout>
                                        <Label x:Name="CheckLabel" Grid.Column="2" Text="✓" FontSize="18" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandGreen}" VerticalOptions="Center" Opacity="0" />
                                    </Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter TargetName="PayBorder" Property="Border.Stroke" Value="{StaticResource BrandGreen}" />
                                                    <Setter TargetName="PayBorder" Property="Border.BackgroundColor" Value="#EEF5EA" />
                                                    <Setter TargetName="CheckLabel" Property="Label.Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding Total, StringFormat='Place Order · £{0:0.00}'}"
                            Style="{StaticResource CtaButton}" Command="{Binding PlaceOrderCommand}" Margin="0,6,0,0" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- ============ CONFIRMATION ============ -->
            <ScrollView IsVisible="{Binding OrderPlaced}">
                <VerticalStackLayout Padding="30" Spacing="14" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="440">

                    <Border Style="{StaticResource SuccessCircle}" HorizontalOptions="Center">
                        <Label Text="✓" FontSize="42" TextColor="White" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="Order Confirmed!" FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" HorizontalOptions="Center" Margin="0,8,0,0" />

                    <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource BrandCream}" Stroke="{StaticResource BrandBorder}"
                            Padding="14,6" HorizontalOptions="Center">
                        <Label Text="{Binding OrderNumber}" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                    </Border>

                    <Label Text="{Binding ConfirmationMessage}" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource BrandTextMuted}" Margin="0,4,0,10" />

                    <Button Text="Continue Shopping" Style="{StaticResource PrimaryButton}" Command="{Binding BackToShoppingCommand}"
                            WidthRequest="240" />
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>
</ContentPage>