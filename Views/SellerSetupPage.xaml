<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AfroPhloem.ViewModels"
             xmlns:controls="clr-namespace:AfroPhloem.Views.Controls"
             x:DataType="vm:SellerSetupViewModel"
             x:Class="AfroPhloem.Views.SellerSetupPage"
             Shell.NavBarIsVisible="False"
             Title="Become a Seller">

    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderBar Grid.Row="0" />

        <ScrollView Grid.Row="1" HorizontalOptions="Fill">
            <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="560" HorizontalOptions="Fill" WidthRequest="-1">

                <Label Text="Set Up Your Vendor Profile" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" HorizontalOptions="Fill" />
                <Label Text="Home cooks, small businesses, and market vendors are all welcome." Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" HorizontalOptions="Fill" />

                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#EEF5EA" Stroke="{StaticResource BrandGreen}"
                        Padding="12,8" IsVisible="{Binding IsLoggedIn}">
                    <Label Text="{Binding LoggedInAsText}" FontSize="13" TextColor="{StaticResource BrandGreen}" />
                </Border>

                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FBEAE8" Stroke="{StaticResource BrandDanger}"
                        Padding="12,8" IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="You need to log in first — a seller account is linked to your existing Phloem account."
                               FontSize="13" TextColor="{StaticResource BrandDanger}" />
                        <Button Text="Log In" Style="{StaticResource OutlineButton}" HeightRequest="36"
                                Command="{Binding GoToLoginCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Image Source="dotnet_bot.png" HeightRequest="80" WidthRequest="80" />
                        <Button Text="Upload Shop Logo" Style="{StaticResource OutlineButton}" Command="{Binding PickLogoCommand}" />
                        <Label Text="{Binding LogoFileName}" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill" WidthRequest="-1">
                    <Entry Placeholder="Business Name" Text="{Binding BusinessName}" BackgroundColor="Transparent" HeightRequest="46" HorizontalOptions="Fill" />
                </Border>
                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill" WidthRequest="-1">
                    <Entry Placeholder="Business Email (leave blank to use your account email)" Keyboard="Email"
                           Text="{Binding BusinessEmail}" BackgroundColor="Transparent" HeightRequest="46" HorizontalOptions="Fill" />
                </Border>
                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill" WidthRequest="-1">
                    <Entry Placeholder="Business Phone (leave blank to use your account phone)" Keyboard="Telephone"
                           Text="{Binding BusinessPhone}" BackgroundColor="Transparent" HeightRequest="46" HorizontalOptions="Fill" />
                </Border>

                <Button Text="Create Vendor Profile" Style="{StaticResource PrimaryButton}" Command="{Binding CreateVendorProfileCommand}"
                        HorizontalOptions="Fill" HeightRequest="52" WidthRequest="-1" />

                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>