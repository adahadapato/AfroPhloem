<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AfroPhloem.ViewModels"
             xmlns:controls="clr-namespace:AfroPhloem.Views.Controls"
             x:DataType="vm:RegisterViewModel"
             x:Class="AfroPhloem.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             Title="Sign Up">

    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderBar Grid.Row="0" ShowBackButton="False" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="560" HorizontalOptions="Center">

                <Label Text="Create your Phloem account" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                <Label Text="Selling instead? Head to Become a Seller from the menu once you're signed up."
                       Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill">
                    <Entry Placeholder="Full Name" Text="{Binding FullName}" BackgroundColor="Transparent" />
                </Border>
                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill">
                    <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" BackgroundColor="Transparent" />
                </Border>
                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill">
                    <Entry Placeholder="Phone Number" Keyboard="Telephone" Text="{Binding PhoneNumber}" BackgroundColor="Transparent" />
                </Border>
                <Border Style="{StaticResource InputBorder}" HorizontalOptions="Fill">
                    <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" BackgroundColor="Transparent" />
                </Border>

                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding AgreedToTerms}" />
                    <Label Text="I agree to the Terms &amp; Conditions" VerticalOptions="Center" TextColor="{StaticResource BrandTextDark}" />
                </HorizontalStackLayout>

                <Button Text="Sign Up" Style="{StaticResource PrimaryButton}" Command="{Binding SignUpCommand}"
                        HorizontalOptions="Fill" />

                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>