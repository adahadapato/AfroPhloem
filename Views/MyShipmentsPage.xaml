<?xml version="1.0" encoding="UTF-8" ?>
<!--
    MyShipmentsPage (route "myshipments"): the signed-in sender's parcels from the API.
    Tap a card → Shipment details (status, timeline, pay, cancel).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             xmlns:models="clr-namespace:Phloem.Models"
             x:DataType="vm:MyShipmentsViewModel"
             x:Class="Phloem.Views.MyShipmentsPage"
             Shell.NavBarIsVisible="False"
             Title="My shipments">

    <ContentPage.Resources>
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallMuted" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsLoading}">
            <ScrollView>
                <VerticalStackLayout Padding="16,18,16,28" Spacing="14" MaximumWidthRequest="560" HorizontalOptions="Fill">

                    <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="My shipments" FontSize="26" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="Tap a parcel to see where it is" Style="{StaticResource SubtleLabel}" FontSize="13" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+ Send" Command="{Binding SendParcelCommand}"
                                Style="{StaticResource CtaButton}" HeightRequest="40" Padding="16,0"
                                VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding Message}" Style="{StaticResource SubtleLabel}" FontSize="14"
                           HorizontalTextAlignment="Center" Margin="0,20,0,0"
                           IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}" />

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Shipments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ShipmentCard">
                                <Border Style="{StaticResource WhiteCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MyShipmentsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding TrackingNumber}" FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextDark}" />
                                            <!-- Status chip: orange when someone must act, red when cancelled -->
                                            <Border Grid.Column="1" BackgroundColor="{StaticResource BrandMintPale}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3"
                                                VerticalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding NeedsAction}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FFF1E0" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsCancelled}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FDECEA" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDark}" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding RouteText}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandDark}" />
                                        <Label Text="{Binding PeopleText}" Style="{StaticResource SmallMuted}" />
                                        <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" Margin="0,4" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Style="{StaticResource SmallMuted}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding DetailsText}" />
                                                        <Span Text="  ·  " />
                                                        <Span Text="{Binding BookedAtText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextDark}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ◀ Page x of y ▶ · Show n -->
                    <controls:PagerView Paging="{Binding Pager}" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
