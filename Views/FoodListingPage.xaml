<?xml version="1.0" encoding="UTF-8" ?>
<!--
    FoodListingPage: redesigned to match "FoodListingPage.xaml / listing / Proposed redesign".
    No AppHeaderBar: the green header is built into the page.
    Uses FoodListingViewModel (existing vendor filter + cart, plus SearchText, category chips, sorting).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:models="clr-namespace:Phloem.Models"
             x:DataType="vm:FoodListingViewModel"
             x:Class="Phloem.Views.FoodListingPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="Browse &amp; Order">

    <ContentPage.Resources>
        <!-- Category chips (unselected look) -->
        <Style x:Key="CategoryChip" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="BorderColor" Value="{StaticResource BrandBorder}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <!-- White rounded box around a Picker -->
        <Style x:Key="PickerBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="HeightRequest" Value="46" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- ============ CART ICON + COUNT (shows once something is in the basket) ============ -->
                <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"
                      IsVisible="{Binding CartCount, Converter={StaticResource IntToBoolConverter}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCartTapped" />
                    </Grid.GestureRecognizers>
                    <!-- Cart drawn in white (swap for <Image Source="cart_icon.png" .../> if you prefer your icon) -->
                    <Path Data="M2.5,4 L5.5,4 L7.9,14.5 L18.1,14.5 L20.5,7 L7,7 M9.5,19 A1.6,1.6 0 1 0 9.51,19 M16.5,19 A1.6,1.6 0 1 0 16.51,19"
                          Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                          WidthRequest="26" HeightRequest="26"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- Orange count bubble -->
                    <Border BackgroundColor="{StaticResource BrandOrangeLight}" Stroke="{StaticResource BrandDark}"
                            StrokeThickness="2" StrokeShape="RoundRectangle 10"
                            MinimumWidthRequest="20" HeightRequest="20" Padding="5,0"
                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,-2,-4,0">
                        <Label Text="{Binding CartCount}" TextColor="White" FontSize="11" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Flag of the selected country (change it with the picker below) -->
                <Border Grid.Column="3" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{Binding SelectedCountry.FlagEmoji}" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFlagTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,24" Spacing="12"
                                 MaximumWidthRequest="700" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <VerticalStackLayout Spacing="2" Margin="2,0,0,2">
                    <Label Text="Discover delicious food" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Find flavours from your community"
                           Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <!-- ============ SEARCH ============ -->
                <Border BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="48">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Path Data="M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 M15.5,15.5 L21,21"
                              Stroke="{StaticResource BrandTextMuted}" StrokeThickness="2" StrokeLineCap="Round"
                              WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Search meals, ingredients or vendors"
                               Text="{Binding SearchText}" ReturnType="Search"
                               BackgroundColor="Transparent" FontSize="14"
                               TextColor="{StaticResource BrandTextDark}"
                               PlaceholderColor="{StaticResource BrandTextMuted}"
                               VerticalOptions="Center" />
                        <Path Grid.Column="2"
                              Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M7,4 L7,8 M16,10 L16,14 M10,16 L10,20"
                              Stroke="{StaticResource BrandTextMuted}" StrokeThickness="2" StrokeLineCap="Round"
                              WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ============ CATEGORY CHIPS ============ -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="All" Style="{StaticResource CategoryChip}"
                                Command="{Binding FilterCategoryCommand}" CommandParameter="All">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="All">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Local Meals" Style="{StaticResource CategoryChip}"
                                Command="{Binding FilterCategoryCommand}" CommandParameter="Local Meals">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Local Meals">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Snacks" Style="{StaticResource CategoryChip}"
                                Command="{Binding FilterCategoryCommand}" CommandParameter="Snacks">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Snacks">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Drinks" Style="{StaticResource CategoryChip}"
                                Command="{Binding FilterCategoryCommand}" CommandParameter="Drinks">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Drinks">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ============ COUNTRY + DELIVERY PICKERS ============ -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource PickerBox}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker Title="Country" ItemsSource="{Binding Countries}"
                                    SelectedItem="{Binding SelectedCountry}" ItemDisplayBinding="{Binding Name}"
                                    FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent"
                                    TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            <Path Grid.Column="1" Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                                  StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="12" HeightRequest="12" VerticalOptions="Center" InputTransparent="True" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PickerBox}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="2">
                            <Label Text="Delivery:" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            <Picker Grid.Column="1" Title="Delivery time" ItemsSource="{Binding DeliveryTimes}"
                                    SelectedItem="{Binding SelectedDeliveryTime}"
                                    FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent"
                                    TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                            <Path Grid.Column="2" Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                                  StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="12" HeightRequest="12" VerticalOptions="Center" InputTransparent="True" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ VENDOR FILTER BANNER ("View shop") ============ -->
                <Border BackgroundColor="{StaticResource BrandMintPale}" Stroke="{StaticResource BrandMint}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10"
                        IsVisible="{Binding IsFilteredByVendor}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding FilterVendorName, StringFormat='Showing dishes from {0}'}"
                               FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandDark}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕  Clear" Command="{Binding ClearVendorFilterCommand}"
                                BackgroundColor="White" TextColor="{StaticResource BrandDark}"
                                BorderColor="{StaticResource BrandMint}" BorderWidth="1"
                                FontSize="12" FontAttributes="Bold" CornerRadius="14" HeightRequest="30" Padding="12,0" />
                    </Grid>
                </Border>

                <!-- ============ POPULAR NEAR YOU ============ -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,6,0,0">
                    <Label Text="Popular near you" Style="{StaticResource SectionTitle}" />
                    <Label Grid.Column="1" Text="Filter" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource BrandDark}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource BrandGreen}" HeightRequest="28" />
                <Label Text="{Binding EmptyMessage}" Style="{StaticResource SubtleLabel}"
                       Margin="2,0,0,0" IsVisible="{Binding IsEmpty}" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Dishes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Dish">
                            <Border BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16" Padding="8">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="100,*" ColumnSpacing="14">
                                    <!-- Dish photo -->
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            WidthRequest="100" HeightRequest="80">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>

                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto"
                                          RowSpacing="2" Padding="0,4,4,0">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandOrange}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="★ " />
                                                    <Span Text="{Binding Rating, StringFormat='{0:0.0}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding VendorName}"
                                               FontSize="12" TextColor="{StaticResource BrandTextMuted}"
                                               LineBreakMode="TailTruncation" />

                                        <Label Grid.Row="2" Text="{Binding PriceText}"
                                               FontSize="17" FontAttributes="Bold" TextColor="{StaticResource BrandOrange}"
                                               VerticalOptions="End" />
                                        <Button Grid.Row="2" Grid.Column="1" Text="+"
                                                Style="{StaticResource CircleIconButton}"
                                                BackgroundColor="{StaticResource BrandDark}" VerticalOptions="End"
                                                Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ CART BAR (shows once something is added) ============ -->
        <Border Grid.Row="2"
                IsVisible="{Binding CartCount, Converter={StaticResource IntToBoolConverter}}"
                BackgroundColor="{StaticResource BrandDark}"
                StrokeThickness="0" StrokeShape="RoundRectangle 16"
                Margin="16,0,16,12" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding CartCount, StringFormat='{0} item(s) in your basket'}"
                           FontSize="12" TextColor="{StaticResource BrandGoldLight}" />
                    <Label Text="{Binding CartTotalText}" FontSize="17"
                           FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Checkout  ›" Style="{StaticResource CtaButton}"
                        HeightRequest="42" FontSize="15" Padding="18,0"
                        Command="{Binding GoToCheckoutCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
