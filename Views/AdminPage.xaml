<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AfroPhloem.ViewModels"
             xmlns:models="clr-namespace:AfroPhloem.Models"
             xmlns:controls="clr-namespace:AfroPhloem.Views.Controls"
             x:DataType="vm:AdminViewModel"
             x:Class="AfroPhloem.Views.AdminPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="Admin Dashboard">

    <Grid RowDefinitions="Auto,*">
        <controls:AppHeaderBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="700" HorizontalOptions="Center">

                <Label Text="Admin Dashboard" Style="{StaticResource SectionTitle}" />
                <Label Text="Manage sellers and monitor cross-border shipments." Style="{StaticResource SubtleLabel}" />

                <!-- Stats strip -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource StatTile}" WidthRequest="-1" HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding TotalVendors}" Style="{StaticResource StatNumber}" />
                            <Label Text="Total Sellers" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatTile}" WidthRequest="-1" HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding TotalUsers}" Style="{StaticResource StatNumber}" TextColor="{StaticResource BrandGreen}" />
                            <Label Text="Total Users" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatTile}" WidthRequest="-1" HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding PendingApprovalCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource BrandOrange}" />
                            <Label Text="Pending Approval" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatTile}" WidthRequest="-1" HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding BlockedCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource BrandDanger}" />
                            <Label Text="Blocked" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource StatTile}" WidthRequest="-1" HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding TotalShipments}" Style="{StaticResource StatNumber}" />
                            <Label Text="Shipments" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Tab toggle -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0" HeightRequest="46">
                    <Button Grid.Column="0" Text="Sellers" Command="{Binding ShowSellersCommand}" CornerRadius="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Sellers">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Shipments">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Users">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Shipments" Command="{Binding ShowShipmentsCommand}" CornerRadius="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Shipments">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Sellers">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Users">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Users" Command="{Binding ShowUsersCommand}" CornerRadius="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Users">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Sellers">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Shipments">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
                                <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- ============ SELLERS TAB ============ -->
                <VerticalStackLayout Spacing="14" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="Sellers">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Pending Approval" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="No sellers awaiting approval." Style="{StaticResource SubtleLabel}"
                           IsVisible="{Binding HasPendingApprovals, Converter={StaticResource InvertedBoolConverter}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingVendors}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Vendor">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding Country}" Style="{StaticResource SubtleLabel}" />
                                            <Label Text="{Binding BusinessEmail}" Style="{StaticResource SubtleLabel}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Approve" BackgroundColor="{StaticResource BrandGreen}"
                                                TextColor="White" FontSize="12" HeightRequest="34" CornerRadius="8"
                                                Command="{Binding BindingContext.ApproveVendorCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2" Text="Reject" BackgroundColor="{StaticResource BrandDanger}"
                                                TextColor="White" FontSize="12" HeightRequest="34" CornerRadius="8"
                                                Command="{Binding BindingContext.RejectVendorCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandBorder}" Margin="0,6" />

                    <Label Text="Active Sellers" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource BrandTextDark}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActiveVendors}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Vendor">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                                    <Border BackgroundColor="{StaticResource BrandDanger}" StrokeShape="RoundRectangle 6"
                                                            Padding="6,1" IsVisible="{Binding IsBlocked}">
                                                        <Label Text="BLOCKED" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Country}" Style="{StaticResource SubtleLabel}" />
                                                <Label Text="{Binding Rating, StringFormat='⭐ {0:0.0}'}" Style="{StaticResource SubtleLabel}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Block" BackgroundColor="{StaticResource BrandDanger}"
                                                    TextColor="White" FontSize="12" HeightRequest="34" WidthRequest="90" CornerRadius="8"
                                                    Command="{Binding BindingContext.ToggleBlockCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Text" Value="Unblock" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>

                                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandBorder}" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                <CheckBox IsChecked="{Binding IsVerified}" Color="{StaticResource BrandGreen}" />
                                                <Label Text="Verified seller" FontSize="13" TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Button Grid.Column="1" Text="View Shop" Style="{StaticResource OutlineButton}"
                                                    FontSize="12" HeightRequest="34"
                                                    Command="{Binding BindingContext.ViewShopCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ============ SHIPMENTS TAB ============ -->
                <VerticalStackLayout Spacing="10" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="Shipments">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Cross-Border Shipments" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource BrandTextDark}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Shipments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DeliveryOrder">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding ItemDescription}" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                            <Label Grid.Column="1" Text="{Binding Status}" FontAttributes="Bold" FontSize="11" TextColor="{StaticResource BrandGreen}" />
                                        </Grid>
                                        <Label Text="{Binding SenderName, StringFormat='From: {0}'}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding RecipientName, StringFormat='To: {0}'}" Style="{StaticResource SubtleLabel}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding FromCountry, StringFormat='{0} → UK'}" Style="{StaticResource SubtleLabel}" />
                                            <Label Grid.Column="1" Text="{Binding Speed}" Style="{StaticResource SubtleLabel}" />
                                        </Grid>
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy · h:mm tt}'}" Style="{StaticResource SubtleLabel}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ============ USERS TAB ============ -->
                <VerticalStackLayout Spacing="10" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="Users">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Registered Users" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Passwords are never stored or shown here." Style="{StaticResource SubtleLabel}" FontAttributes="Italic" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Users}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding FullName}" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                        <Label Text="{Binding Email, StringFormat='📧 {0}'}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding PhoneNumber, StringFormat='📞 {0}'}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding DefaultAddress.FullAddress, StringFormat='📍 {0}'}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding Addresses.Count, StringFormat='{0} saved address(es)'}" Style="{StaticResource SubtleLabel}" FontSize="11" />
                                        <Label Text="{Binding Country}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding JoinedAt, StringFormat='Joined {0:MMM d, yyyy}'}" Style="{StaticResource SubtleLabel}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>