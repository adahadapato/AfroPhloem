<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AboutPage: redesigned to match "AboutPage.xaml / about / Proposed redesign".
    Uses only Colors.xaml / Styles.xaml.
    Images used: header_logo.png, hero_food_photo.png
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             x:Class="Phloem.Views.AboutPage"
             Shell.NavBarIsVisible="False"
             Title="About Phloem">

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <!-- Menu icon (opens the side menu) -->
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Flag pill (shows the country chosen on Home) -->
                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="FlagLabel" Text="🌍" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="12"
                                 MaximumWidthRequest="720" HorizontalOptions="Fill">

                <!-- ============ OUR STORY CARD ============ -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16"
                        BackgroundColor="{StaticResource BrandHeroGreen}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Our story" TextColor="{StaticResource BrandGoldLight}" FontSize="13" />
                            <Label Text="Food that feels like home." TextColor="White"
                                   FontSize="21" FontAttributes="Bold" LineHeight="1.05" />
                            <Label Text="Africa  •  Diaspora  •  Food" TextColor="White"
                                   FontSize="11" Opacity="0.9" Margin="0,6,0,0" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                WidthRequest="130" HeightRequest="120" VerticalOptions="Center"
                                BackgroundColor="{StaticResource BrandCard}">
                            <Image Source="hero_food_photo.png" Aspect="AspectFill" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ CONNECTING COMMUNITIES ============ -->
                <VerticalStackLayout Spacing="4" Margin="2,14,2,4">
                    <Label Text="Connecting communities" Style="{StaticResource SectionTitle}" />
                    <Label Text="Phloem brings authentic African food closer to families, homes and hearts."
                           Style="{StaticResource SubtleLabel}" FontSize="14" />
                </VerticalStackLayout>

                <!-- Feature card 1 -->
                <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                            <Label Text="✦" FontSize="16" TextColor="{StaticResource BrandGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Celebrate African cuisine" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="Local meals and cultural flavours" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Feature card 2 -->
                <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                            <Label Text="✓" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Empower independent sellers" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="Tools for cooks and food businesses" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Feature card 3 -->
                <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                            <Path Data="M3,10 L17,10 M12,5 L17,10 L12,15"
                                  Stroke="{StaticResource BrandGreen}" StrokeThickness="2.2"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="20" HeightRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Connect Africa with the UK" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="Convenient cross-border ordering" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ============ FOOTER ============ -->
                <Label Margin="2,16,0,0" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Phloem" />
                            <Span Text="   •   " />
                            <Span Text="Version 1.0" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
