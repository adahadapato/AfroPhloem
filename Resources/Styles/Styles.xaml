<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Every existing style key is kept (restyled to the new palette), new ones are marked NEW. -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCream}" />
    </Style>

    <!-- NEW: bottom tab bar colours for every Shell page -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource BrandNavGreen}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource BrandOrangeLight}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource BrandOrangeLight}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource BrandMint}" />
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource BrandDark}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
    </Style>

    <Style x:Key="HeaderBar" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="LogoLabel" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="19" />
    </Style>

    <Style x:Key="SubtleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- NEW: prices in orange -->
    <Style x:Key="PriceLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandPrice}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- NEW: "See all ›" style links -->
    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandMint}" />
        <Setter Property="TextColor" Value="{StaticResource BrandDark}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="CtaButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandOrange}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
        <Setter Property="TextColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="BorderColor" Value="{StaticResource BrandMint}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource BrandTextMuted}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- About page: enterprise-style hero, stats, and section styling -->
    <Style x:Key="EyebrowLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandGold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <Style x:Key="HeroTitle" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="34" />
    </Style>

    <Style x:Key="HeroSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandGoldLight}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Italic" />
    </Style>

    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="WidthRequest" Value="150" />
        <Setter Property="HeightRequest" Value="110" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.10" Radius="10" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatNumber" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="StatCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="ComparisonCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="WidthRequest" Value="340" />
    </Style>

    <!-- Home page redesign -->
    <Style x:Key="IconCircle" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Buy / Sell cards: now a row (icon, text, arrow); set BackgroundColor per card -->
    <Style x:Key="QuickActionCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10,12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.12" Radius="14" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NEW: small round arrow on the Buy / Sell cards and promo banner -->
    <Style x:Key="ArrowCircle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 13" />
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ArrowGlyph" TargetType="Label">
        <Setter Property="Text" Value="›" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,-3,0,0" />
    </Style>

    <!-- NEW: category chips (Popular, Local Meals, ...) -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="PillLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
    </Style>

    <Style x:Key="RatingBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#99000000" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <Style x:Key="DishCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VendorCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,0,12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round action button: the "+" on dish cards and quantity +/- steppers -->
    <Style x:Key="CircleIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PaymentCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SuccessCircle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 50" />
        <Setter Property="WidthRequest" Value="90" />
        <Setter Property="HeightRequest" Value="90" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
</ResourceDictionary>
