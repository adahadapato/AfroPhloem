<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCream}" />
    </Style>

    <Style x:Key="HeaderBar" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="LogoLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandGold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="SubtleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGoldLight}" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="CtaButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandOrange}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="BorderColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

   <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource BrandTextMuted}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- About page: enterprise-style hero, stats, and section styling -->
    <Style x:Key="EyebrowLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandGold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <Style x:Key="HeroTitle" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="34" />
    </Style>

    <Style x:Key="HeroSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BrandGoldLight}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Italic" />
    </Style>

    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="WidthRequest" Value="150" />
        <Setter Property="HeightRequest" Value="110" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatNumber" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="StatCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="ComparisonCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="WidthRequest" Value="340" />
    </Style>

    <!-- Home page redesign -->
    <Style x:Key="IconCircle" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="QuickActionCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="16,18" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.10" Radius="10" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillLabel" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
    </Style>

    <Style x:Key="RatingBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#CC1A1A1A" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="DishCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.10" Radius="8" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VendorCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="0,0,0,14" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.10" Radius="8" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round action button, e.g. quantity +/- steppers -->
    <Style x:Key="CircleIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--<Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.10" Radius="8" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>-->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.10" Radius="8" Offset="0,3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PaymentCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandCard}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SuccessCircle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 50" />
        <Setter Property="WidthRequest" Value="90" />
        <Setter Property="HeightRequest" Value="90" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
</ResourceDictionary>
